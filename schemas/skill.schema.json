{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/FTurleque/ai-skills-registry/schemas/skill.schema.json",
  "title": "Skill Metadata",
  "description": "Schéma de validation des métadonnées d'un skill du registre AI Skills Registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "displayName",
    "description",
    "version",
    "status",
    "category",
    "tags",
    "compatibility",
    "authors",
    "license"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Identifiant unique du skill en kebab-case.",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "description": "Nom lisible du skill.",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description courte du skill.",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "Version du skill au format Semantic Versioning.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-(0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*)?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$"
    },
    "status": {
      "type": "string",
      "description": "Statut du skill.",
      "enum": ["draft", "experimental", "stable", "deprecated"]
    },
    "category": {
      "type": "string",
      "description": "Catégorie fonctionnelle du skill.",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "description": "Liste de tags décrivant le skill.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "compatibility": {
      "type": "array",
      "description": "Liste des outils IA compatibles avec ce skill.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "authors": {
      "type": "array",
      "description": "Liste des auteurs du skill.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "license": {
      "type": "string",
      "description": "Licence SPDX du skill (ex. MIT, Apache-2.0).",
      "minLength": 1
    }
  }
}
