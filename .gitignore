# Éditeurs et IDE
.idea/
.vscode/
*.swp
*.swo

# Systèmes d'exploitation
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs et fichiers temporaires
*.log
*.tmp
*.temp
*.bak

# Variables d'environnement et secrets
.env
.env.*
*.secret

# Dépendances (au cas où un outil serait ajouté plus tard)
node_modules/
vendor/

# Python (moteurs livrés dans les resources/ de certains skills)
__pycache__/
*.py[cod]
.pytest_cache/

# Rapports du superviseur de code : jamais commités
docs/rapport-supervisor/

# Artefacts de build
dist/
build/
out/

# Archgate generated runtime (regenerated by archgate)
.archgate/rules.d.ts
