{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python tools/validate.py:*)",
      "Bash(python tools/generate_index.py:*)",
      "Bash(python plugins/*/resources/supervisor.py --self-test)",
      "Bash(claude plugin validate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.secret)"
    ]
  }
}
